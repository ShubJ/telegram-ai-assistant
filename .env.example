# ===========================================================================
# Telegram AI Assistant — Environment Configuration
# ===========================================================================
# Copy this file to .env and fill in the required values.
#   cp .env.example .env
# ===========================================================================

# ---------------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------------

# Telegram bot token from @BotFather (https://t.me/BotFather)
# 1. Message @BotFather on Telegram
# 2. Send /newbot and follow the prompts
# 3. Copy the token here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ---------------------------------------------------------------------------
# OPTIONAL — Server
# ---------------------------------------------------------------------------

# Claude model to use (default: claude-sonnet-4-20250514)
# Other options: claude-opus-4-5, claude-haiku-4-5-20251001
CLAUDE_MODEL=claude-sonnet-4-20250514

# Log level: debug, info, warn, error (default: info in production, debug in development)
LOG_LEVEL=debug

# HTTP port for the Express server and admin dashboard (default: 3000)
PORT=3000

# Node environment: development | production | test
NODE_ENV=development

# Secret token for authenticating admin API requests
# Leave empty to disable admin API auth (not recommended in production)
ADMIN_SECRET=change_this_to_a_secure_secret

# ---------------------------------------------------------------------------
# OPTIONAL — Skill API Keys
# ---------------------------------------------------------------------------

# Brave Search API key — enables the web search skill
# Get one at https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=

# OpenWeatherMap API key — enables the weather skill
# Get one at https://openweathermap.org/api (free tier available)
OPENWEATHER_API_KEY=

# GitHub personal access token — enables the multi-agent system to create repos and PRs
# Get one at https://github.com/settings/tokens (needs repo scope)
GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# OPTIONAL — Database
# ---------------------------------------------------------------------------

# Path to the SQLite database file (default: ./data/assistant.db)
# The directory will be created automatically if it doesn't exist.
DATABASE_PATH=./data/assistant.db
